# .env.template — copy to .env and fill in your key.
# .env is gitignored and must NEVER be committed.

# Extraction provider: openai (default) or anthropic.
EXTRACTION_PROVIDER=openai

# Required when EXTRACTION_PROVIDER=openai (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_key_here

# Required only when EXTRACTION_PROVIDER=anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=your_key_here

# Optional: model override. Defaults: openai -> gpt-6-astra, anthropic -> claude-sonnet-4-6.
# EXTRACTION_MODEL=gpt-6-astra

# Optional (Windows only): path to a blank SolidWorks part template.
# If unset, the SolidWorks default part template is used.
# SolidWorks 2025 install on the AILOT machine:
SOLIDWORKS_TEMPLATE_PATH=C:\ProgramData\SolidWorks\SOLIDWORKS 2025\templates\Part.PRTDOT

# Hard API spend cap in USD across ALL runs on this machine (default 20).
# Spend is tracked in usage/budget_ledger.jsonl; a run stops (exit 9) before
# any call whose worst case would cross the cap.
# API_BUDGET_USD=20
# Reasoning effort for OpenAI models: none|minimal|low|medium|high|xhigh (unset = model default).
# OPENAI_REASONING_EFFORT=
