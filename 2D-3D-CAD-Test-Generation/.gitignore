# Secrets — NEVER commit the API key (any .env variant; the template is safe)
.env
.env.*
!.env.template

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Pipeline artifacts
output/*.sldprt
output/*.SLDPRT
debug_extraction.json
*.log

# Extraction cache (hashed API results)
.extraction_cache/
**/.extraction_cache/

# Token & cost ledger (run artifacts)
token_usage_log.txt
token_usage_log.jsonl
**/token_usage_log.*

# Per-completion token ledger + generated reports (pipeline/token_tracker.py)
**/usage/usage_ledger.jsonl
**/usage/budget_ledger.jsonl
**/usage/usage_report.html
**/usage/usage*.csv

# OS
.DS_Store
Thumbs.db

# SolidWorks lock and autosave files
~$*
**/AUTOSAVE_*.SLDPRT
**/AUTOSAVE_*.sldprt

# demo.py run outputs
output/demo/
